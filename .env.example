# csm tracker credentials. Copy to .env (gitignored) and fill in:
#   cp .env.example .env
# Connections in ~/.claude/csm.json name these with "token_env".
# Real environment variables override this file.

# Linear: Settings → Security & access → Personal API keys → New API key (Read access is enough)
LINEAR_API_KEY=

# YouTrack: avatar → Profile → Account Security → New token (scope: YouTrack)
YOUTRACK_TOKEN=
