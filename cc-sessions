# ── Task sources (adapter layer) ────────────────────────────────────
#
# Trackers (Linear, YouTrack, ...) plug in as adapter files; the core never
# names a tracker. See docs/plans/task-integrations.md.
#
#   adapters/<name>.py       built-in adapters, shipped with csm
#   ~/.claude/csm/adapters/  user plugins (same contract; may override built-ins)
#
# Adapter contract (duck-typed; adapters never import this file):
#   module-level  ADAPTERS = [Class, ...]
#   Class.kind                     registry name, used as connections.<name>.type
#   Class(options, http)           options = connection config + resolved "token"
#   .get(key)                  ->  task dict or None if not found     (required)
#   .search(text, limit, scope) -> [task dict]                         (optional)
#   .recent(limit, scope)      ->  [task dict] open tasks, newest first (optional)
#   .whoami()                  ->  str, used by `csm connections`       (optional)
# scope is the tracker-side project (Linear team key, YouTrack project code).
# A task dict has "key" and "title"; see TASK_FIELDS for the rest.

TASK_FIELDS = ('key', 'title', 'url', 'status', 'assignee', 'project',
               'description', 'updated')
SCRIPT_DIR = pathlib.Path(os.path.realpath(__file__)).parent
ADAPTER_DIRS = [SCRIPT_DIR / "adapters", CLAUDE_DIR / "csm" / "adapters"]
CACHE_DIR = CLAUDE_DIR / "csm-cache"
_TICKET_RE = re.compile(r'^([A-Za-z][A-Za-z0-9]*)-(\d+)$')


class TaskSourceError(Exception):
    """Any failure talking to a tracker, with a message fit for the user."""


class HttpError(TaskSourceError):
    def __init__(self, status, message):
        super().__init__(message)
        self.status = status


class Http:
    """Tiny stdlib JSON-over-HTTP helper injected into adapters."""
    Error = HttpError

    def __init__(self, timeout=10):
        self.timeout = timeout

    def request(self, method, url, params=None, body=None, headers=None):
        import urllib.request, urllib.parse, urllib.error
        if params:
            url += ('&' if '?' in url else '?') + urllib.parse.urlencode(params)
        data = json.dumps(body).encode() if body is not None else None
        hdrs = {'Accept': 'application/json', 'User-Agent': 'csm'}
        if data is not None:
            hdrs['Content-Type'] = 'application/json'
        hdrs.update(headers or {})
        req = urllib.request.Request(url, data=data, headers=hdrs, method=method)
        try:
            with urllib.request.urlopen(req, timeout=self.timeout) as r:
                raw = r.read()
        except urllib.error.HTTPError as e:
            host = urllib.parse.urlsplit(url).netloc
            if e.code in (401, 403):
                raise HttpError(e.code, f"{host} rejected the token (HTTP {e.code}); check it in {_env_file()}")
            detail = e.read()[:300].decode('utf-8', 'replace').strip()
            raise HttpError(e.code, f"HTTP {e.code} from {host}: {detail}")
        except (urllib.error.URLError, OSError) as e:
            raise HttpError(0, f"cannot reach {urllib.parse.urlsplit(url).netloc}: {e}")
        try:
            return json.loads(raw) if raw else None
        except ValueError:
            raise HttpError(0, f"non-JSON response from {urllib.parse.urlsplit(url).netloc}")

    def get_json(self, url, params=None, headers=None):
        return self.request('GET', url, params=params, headers=headers)

    def post_json(self, url, body, headers=None):
        return self.request('POST', url, body=body, headers=headers)


def _env_file():
    p = os.environ.get("CSM_ENV_FILE")
    return pathlib.Path(p) if p else SCRIPT_DIR / ".env"


def _read_env_file(path):
    """Parse KEY=VALUE lines (optional `export`, quotes, # comments)."""
    out = {}
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return out
    for line in lines:
        line = line.strip()
        if not line or line.startswith('#') or '=' not in line:
            continue
        k, v = line.split('=', 1)
        k = k.strip()
        if k.startswith('export '):
            k = k[7:].strip()
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in '"\'':
            v = v[1:-1]
        out[k] = v
    return out


def _secret(name):
    """Real environment wins over .env."""
    if not name:
        return ''
    return os.environ.get(name) or _read_env_file(_env_file()).get(name, '')


_REGISTRY = None


def _adapter_registry():
    """kind -> class, from every *.py in ADAPTER_DIRS (later dirs override)."""
    global _REGISTRY
    if _REGISTRY is not None:
        return _REGISTRY
    import importlib.util
    reg = {}
    for d in ADAPTER_DIRS:
        if not d.is_dir():
            continue
        for f in sorted(d.glob("*.py")):
            if f.name.startswith('_'):
                continue
            try:
                spec = importlib.util.spec_from_file_location(f"csm_adapter_{f.stem}", f)
                mod = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(mod)
                for cls in getattr(mod, 'ADAPTERS', []):
                    if not getattr(cls, 'kind', None) or not callable(getattr(cls, 'get', None)):
                        raise TypeError(f"{cls!r} needs a `kind` and a get(key) method")
                    reg[cls.kind] = cls
            except Exception as e:
                print(f"csm: skipping adapter {f}: {e}", file=sys.stderr)
    _REGISTRY = reg
    return reg


def _connections():
    return _load_config().get("connections") or {}


_SOURCES = {}


def make_source(name):
    """Factory: connection name -> adapter instance (memoized)."""
    if name in _SOURCES:
        return _SOURCES[name]
    conn = _connections().get(name)
    if not conn:
        raise TaskSourceError(f"no connection named {name!r} in {_config_path()}")
    cls = _adapter_registry().get(conn.get("type"))
    if not cls:
        known = ', '.join(sorted(_adapter_registry())) or 'none found'
        raise TaskSourceError(f"connection {name!r}: unknown type {conn.get('type')!r} (adapters: {known})")
    options = dict(conn)
    token_env = conn.get("token_env")
    if token_env:
        options["token"] = _secret(token_env)
        if not options["token"]:
            raise TaskSourceError(f"connection {name!r}: {token_env} is not set (add it to {_env_file()})")
    _SOURCES[name] = cls(options, Http())
    return _SOURCES[name]


def route(key=None, cwd=None):
    """Which (connection, scope) serves a ticket key or a folder, or (None, None).

    1. the key's prefix is in a connection's "prefixes"  (works from any folder)
    2. the longest "folders" path that contains cwd
    """
    conns = _connections()
    if key:
        m = _TICKET_RE.match(key)
        if m:
            prefix = m.group(1).upper()
            for name, c in conns.items():
                if prefix in [p.upper() for p in c.get("prefixes", [])]:
                    return name, prefix
    if cwd:
        cwd = os.path.realpath(cwd)
        best = None
        for f in _load_config().get("folders") or []:
            p = os.path.realpath(os.path.expanduser(f.get("path", "")))
            if p and (cwd == p or cwd.startswith(p.rstrip(os.sep) + os.sep)):
                if not best or len(p) > len(best[0]):
                    best = (p, f)
        if best:
            return best[1].get("connection"), best[1].get("scope")
    return None, None


def _norm_task(t):
    return {k: ('' if t.get(k) is None else str(t.get(k))) for k in TASK_FIELDS}


def _cache_path(conn):
    return CACHE_DIR / f"{sanitize(conn)}.json"


def _cache_put(conn, tasks):
    if not tasks:
        return
    path = _cache_path(conn)
    try:
        data = json.loads(path.read_text()) if path.exists() else {}
    except Exception:
        data = {}
    items = data.get("tasks", {})
    for t in tasks:
        items[t["key"]] = t
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({"ts": time.time(), "tasks": items}))


def _cache_get(conn):
    try:
        return list(json.loads(_cache_path(conn).read_text()).get("tasks", {}).values())
    except Exception:
        return []


def fetch_task(key, conn):
    src = make_source(conn)
    try:
        t = src.get(key)
    except TaskSourceError:
        raise
    except Exception as e:
        raise TaskSourceError(f"{conn}: {e}")
    if not t:
        return None
    t = _norm_task(t)
    _cache_put(conn, [t])
    return t


def list_tasks(conn, scope=None, text=None, limit=20):
    src = make_source(conn)
    method = 'search' if text else 'recent'
    fn = getattr(src, method, None)
    if not callable(fn):
        raise TaskSourceError(f"connection {conn!r} ({type(src).kind}) does not support {method}")
    try:
        tasks = fn(text, limit, scope) if text else fn(limit, scope)
    except TaskSourceError:
        raise
    except Exception as e:
        raise TaskSourceError(f"{conn}: {e}")
    tasks = [_norm_task(t) for t in tasks or []]
    _cache_put(conn, tasks)
    return tasks


def _fmt_task_line(t):
    status = f"[{t['status']}] " if t['status'] else ''
    return f"{C_BCYAN}{t['key']}{C_RESET}  {C_DIM}{status}{C_RESET}{t['title']}"


def cmd_tasks(text=None, conn=None):
    scope = None
    if not conn:
        conn, scope = route(None, os.getcwd())
    if not conn:
        print(f"No connection for {os.getcwd()}. Add a \"folders\" entry in {_config_path()}, "
              f"or pass --from NAME.", file=sys.stderr)
        sys.exit(1)
    try:
        tasks = list_tasks(conn, scope, text)
    except TaskSourceError as e:
        print(f"csm: {e}", file=sys.stderr)
        sys.exit(1)
    for t in tasks:
        print(_fmt_task_line(t))
    if not tasks:
        print("(no tasks)", file=sys.stderr)


def cmd_connections():
    conns = _connections()
    reg = _adapter_registry()
    print(f"Adapters: {', '.join(sorted(reg)) or '(none)'}")
    print(f"Secrets:  {_env_file()}{'' if _env_file().exists() else '  (missing)'}")
    if not conns:
        print(f"No connections configured in {_config_path()}")
        return
    folders = _load_config().get("folders") or []
    for name, c in conns.items():
        try:
            src = make_source(name)
            who = getattr(src, 'whoami', None)
            state = f"OK ({who()})" if callable(who) else "OK (configured)"
        except Exception as e:
            state = f"FAIL: {e}"
        pref = ','.join(c.get("prefixes", [])) or '-'
        print(f"\n{C_BWHITE}{name}{C_RESET}  type={c.get('type')}  prefixes={pref}  {state}")
        for f in folders:
            if f.get("connection") == name:
                print(f"  {f.get('path')}  scope={f.get('scope') or '-'}")


# ── New session ─────────────────────────────────────────────────────

def _parse_new_input(text):
    """'SET-123', 'SET-123/2', 'SET-123/2.005', each optionally followed by a title.

    Returns (ticket, phase, session, title_or_None), or None if there's no ticket.
    """
    m = re.match(r'^([A-Za-z][A-Za-z0-9]*-\d+)(?:/(\d+)(?:\.(\d+))?)?:?(?:\s+(.*))?$', text.strip())
    if not m:
        return None
    title = (m.group(4) or '').strip() or None
    return m.group(1), int(m.group(2) or 1), int(m.group(3) or 1), title


def _new_session_title(ticket, phase, session, title):
    """Render with the configured naming.full_template (DRY with hop/grouping).
    A custom template that doesn't use these fields falls back to the default."""
    groups = {'ticket': ticket, 'phase': str(phase), 'session': str(session), 'title': title}
    for tpl in (_naming().get("full_template"), DEFAULT_CONFIG["naming"]["full_template"]):
        out = _render_title(tpl or '', groups, 'session') if tpl else None
        if out:
            return out
    return f"{ticket}/{phase}.{session:03d}: {title}"


def cmd_new(text):
    parsed = _parse_new_input(text)
    if not parsed:
        print("Usage: csm new TICKET[/PHASE[.SESSION]] [Title]", file=sys.stderr)
        print("  e.g. csm new SET-123                 (title fetched from the tracker)", file=sys.stderr)
        print("       csm new 'SET-123 Implement settlements'", file=sys.stderr)
        print("       csm new 'SET-123/2.005: Implement settlements'", file=sys.stderr)
        sys.exit(1)
    ticket, phase, session, title = parsed
    if not title:
        conn, _ = route(ticket, os.getcwd())
        if not conn:
            print(f"No title given and no tracker connection for {ticket} "
                  f"(see `csm connections`). Pass a title: csm new '{ticket} Title'", file=sys.stderr)
            sys.exit(1)
        try:
            task = fetch_task(ticket, conn)
        except TaskSourceError as e:
            print(f"csm: {e}", file=sys.stderr)
            sys.exit(1)
        if not task:
            print(f"csm: {ticket} not found in {conn}", file=sys.stderr)
            sys.exit(1)
        ticket, title = task['key'] or ticket, task['title'].strip()
    _start_new(_new_session_title(ticket, phase, session, title))


def _start_new(full_title):
    print(f"→ {full_title}", file=sys.stderr)
    os.execvp('claude', ['claude', '-n', full_title])


def cmd_new_pick():
    """`csm new` with no arguments: pick a task for this folder, then start."""
    conn, scope = route(None, os.getcwd())
    if not conn:
        print(f"No tracker connection for {os.getcwd()} (see `csm connections`).", file=sys.stderr)
        print("Usage: csm new TICKET[/PHASE[.SESSION]] [Title]", file=sys.stderr)
        sys.exit(1)
    sessions = scan_transcripts()

    def run(stdscr):
        _init_curses(stdscr)
        return _task_pick_loop(stdscr, conn, scope, sessions)
    title = _run_curses(run)
    if title:
        _start_new(title)


# ── Delete ──────────────────────────────────────────────────────────

def cmd_del(query):
    sessions = scan_transcripts()
    q = query.lower()
    matches = []
    for s in sessions:
        if s['session_id'].startswith(q):
            matches.append(s)
        elif q in (s.get('title') or '').lower():
            matches.append(s)
    if not matches:
        print(f"No session matching '{query}'", file=sys.stderr)
        sys.exit(1)
    if len(matches) > 1:
        print(f"Multiple matches ({len(matches)}):", file=sys.stderr)
        for s in matches[:10]:
            print(f"  {s['session_id'][:8]}  {s.get('title', '???')}", file=sys.stderr)
        print("Use a more specific query or session ID.", file=sys.stderr)
        sys.exit(1)
    s = matches[0]
    tp = s.get('transcript', '')
    sid = s['session_id'][:8]
    title = s.get('title') or '???'
    if tp and os.path.exists(tp):
        _trash_session(tp)
        print(f"Trashed: {sid}  {title}")
    else:
        print(f"Transcript not found: {tp}", file=sys.stderr)
        sys.exit(1)


def _trash_session(transcript_path):
    TRASH_DIR.mkdir(parents=True, exist_ok=True)
    src = pathlib.Path(transcript_path)
    dst = TRASH_DIR / src.name
    src.rename(dst)


# ── Clipboard ───────────────────────────────────────────────────────

def _autodetect_copy():
    if sys.platform == 'darwin' and shutil.which('pbcopy'):
        return 'pbcopy'
    if os.environ.get('WAYLAND_DISPLAY') and shutil.which('wl-copy'):
        return 'wl-copy'
    if shutil.which('xclip'):
        return 'xclip -selection clipboard'
    if shutil.which('xsel'):
        return 'xsel --clipboard --input'
    if shutil.which('clip.exe'):
        return 'clip.exe'
    if sys.platform.startswith('win') and shutil.which('clip'):
        return 'clip'
    return ''


def _copy_command():
    cmd = os.environ.get('CSM_COPY_CMD')
    if cmd is None:
        cmd = _load_config().get('copy', {}).get('command', '')
    cmd = (cmd or '').strip()
    if cmd == 'auto':
        return _autodetect_copy()
    return cmd


def _copy_to_clipboard(text):
    cmd = _copy_command()
    if not cmd:
        return False
    try:
        subprocess.run(cmd, shell=True, input=text.encode(),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except Exception:
        return False


# ── Hop ─────────────────────────────────────────────────────────────

def _bump_version(title):
    nm = _naming()
    groups = _parse_title(title)
    bf = nm.get("bump_field")
    if groups and bf and bf in groups and groups[bf] is not None:
        try:
            groups = dict(groups)
            groups[bf] = str(int(groups[bf]) + 1)
            out = _render_title(nm.get("full_template", ""), groups, bf)
            if out:
                return out
        except (TypeError, ValueError):
            pass
    m = re.search(r'([-–—]\s*[vV])(\d+)\s*$', title)
    if m:
        num = int(m.group(2)) + 1
        width = len(m.group(2))
        return title[:m.start()] + m.group(1) + str(num).zfill(width)
    m = re.search(r'([-–—]\s*#)(\d+)\s*$', title)
    if m:
        return title[:m.start()] + m.group(1) + str(int(m.group(2)) + 1)
    m = re.search(r'\(([vV])(\d+)\)\s*$', title)
    if m:
        return title[:m.start()] + f'({m.group(1)}{int(m.group(2)) + 1})'
    key = extract_task_key(title)
    return f"{key} - v002"


def _hop_prompt(title, session_id, transcript, handoff=None, message=None):
    """Opening prompt for the continuation session.

    The transcript is the primary context and must be read; the handoff doc is
    an addition, never a replacement. (A version that told the new session to
    only grep the transcript made it lose almost all context.) message is the
    user's own text from `/hop <text>`, appended verbatim.
    """
    prompt = (
        f'Read the previous session transcript at {transcript} '
        f'(JSONL format: user messages in type=user message.content, '
        f'assistant messages in type=assistant message.content[].text). '
    )
    if handoff:
        prompt += f'Also read the handoff document written at the end of that session: {handoff}. '
    prompt += 'Continue where we left off.'
    if message:
        prompt += f'\n\nMessage from the user for this session:\n{message}'
    return prompt


def _find_hop_session(sessions, query=None, current_id=None, cwd=None):
    """Pick the session to hop from.

    query: session-ID prefix, else exact title, else title substring (an exact
    title must win: "SET-1/1.001: X" is also a substring of "SET-1/1.001: X v2").
    No query: the calling Claude session ($CLAUDE_CODE_SESSION_ID, matched on
    session_id or transcript filename). Only when that is unavailable (plain
    CLI use) fall back to the newest session in cwd, which is ambiguous when
    several sessions run in the same directory.
    """
    if query:
        q = query.lower()
        for s in sessions:
            if s['session_id'].startswith(q):
                return s
        titled = [(s, _strip_wrapping_quotes(s.get('title') or '').lower()) for s in sessions]
        q = _strip_wrapping_quotes(q)
        for s, t in titled:
            if t == q:
                return s
        for s, t in titled:
            if q in t:
                return s
        return None
    if current_id:
        for s in sessions:
            if current_id in (s['session_id'], pathlib.Path(s.get('transcript', '')).stem):
                return s
    if cwd:
        cwd_sessions = [s for s in sessions if s.get('cwd', '').startswith(cwd)]
        if cwd_sessions:
            cwd_sessions.sort(key=lambda s: s.get('last_ts') or '', reverse=True)
            return cwd_sessions[0]
    return None


def cmd_hop(query=None, dry_run=False, handoff=None, message=None):
    match = _find_hop_session(scan_transcripts(), query,
                              os.environ.get('CLAUDE_CODE_SESSION_ID'), os.getcwd())
    if not match:
        print(f"No session found{' matching ' + repr(query) if query else ' for ' + os.getcwd()}", file=sys.stderr)
        sys.exit(1)

    title = match.get('title') or 'Untitled'
    new_title = _bump_version(title)
    transcript = match.get('transcript', '')

    if handoff:
        handoff = os.path.abspath(os.path.expanduser(handoff))
        if not os.path.isfile(handoff):
            print(f"Handoff file not found: {handoff}", file=sys.stderr)
            sys.exit(1)
    prompt = _hop_prompt(_strip_wrapping_quotes(title), match.get('session_id', ''),
                         transcript, handoff, message)
    if dry_run:
        clean = _strip_wrapping_quotes(title)
        self_path = os.path.abspath(__file__)
        line = f'{sys.executable} {shlex.quote(self_path)} hop {shlex.quote(clean)}'
        if handoff:
            line += f' --handoff {shlex.quote(handoff)}'
        if message:
            line += f' --message {shlex.quote(message)}'
        copied = _copy_to_clipboard(line)
        print(line)
        if copied:
            print('# copied to clipboard', file=sys.stderr)
    else:
        os.execvp('claude', ['claude', '-n', new_title, prompt])


# ── Shell completion ────────────────────────────────────────────────

CACHE_TTL = 600  # seconds before completion triggers a background refresh
_SUBCOMMANDS = ['new', 'hop', 'tasks', 'connections', 'status', 'note', 'del', 'config', 'completion']


def _cache_age(conn):
    try:
        return time.time() - json.loads(_cache_path(conn).read_text()).get("ts", 0)
    except Exception:
        return float('inf')


def complete_tasks(prefix, cwd):
    """Cached tasks whose key starts with prefix; the folder's project first.
    Never touches the network; a stale cache is refreshed in the background."""
    here, scope = route(None, cwd)
    if here and _cache_age(here) > CACHE_TTL:
        try:
            subprocess.Popen([sys.executable, os.path.realpath(__file__), '_refresh-cache'],
                             cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            pass
    out = []
    for conn in _connections():
        for t in _cache_get(conn):
            if t['key'].upper().startswith(prefix.upper()):
                local = conn == here and (not scope or t.get('project', '').upper() == scope.upper())
                out.append((not local, t))
    out.sort(key=lambda x: x[1].get('updated') or '', reverse=True)  # newest first...
    out.sort(key=lambda x: x[0])  # ...and (stable) this folder's project before others
    return [t for _, t in out[:100]]


def cmd_complete(args):
    if len(args) >= 1 and args[0] == 'new':
        prefix = args[1] if len(args) > 1 else ''
        plain = '--plain' in args
        for t in complete_tasks(prefix, os.getcwd()):
            if plain:
                print(t['key'])
            else:  # zsh _describe format "value:description" (keys never contain ':')
                print(f"{t['key']}:{t['title'].strip()}")


def cmd_refresh_cache():
    conn, scope = route(None, os.getcwd())
    if conn:
        try:
            list_tasks(conn, scope, None, 100)
        except TaskSourceError:
            pass


_ZSH_COMPLETION = r'''# csm zsh completion. Add to ~/.zshrc (after compinit):  source <(csm completion zsh)
# Replaces the `csm` alias with a function so zsh can complete it.
unalias csm 2>/dev/null
csm() { __PY__ __SCRIPT__ "$@"; }
_csm() {
  if (( CURRENT == 2 )); then
    local -a cmds; cmds=(__CMDS__)
    _describe -t commands 'csm command' cmds
  elif (( CURRENT == 3 )) && [[ ${words[2]} == new ]]; then
    local -a items
    items=("${(@f)$(__PY__ __SCRIPT__ _complete new "${words[3]}" 2>/dev/null)}")
    [[ -n ${items[1]} ]] && _describe -t tasks 'task' items
  fi
}
compdef _csm csm
'''

_BASH_COMPLETION = r'''# csm bash completion. Add to ~/.bashrc:  source <(csm completion bash)
# Replaces the `csm` alias with a function so bash can complete it.
unalias csm 2>/dev/null
csm() { __PY__ __SCRIPT__ "$@"; }
_csm() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  if (( COMP_CWORD == 1 )); then
    COMPREPLY=($(compgen -W "__CMDS__" -- "$cur"))
  elif (( COMP_CWORD == 2 )) && [[ ${COMP_WORDS[1]} == new ]]; then
    COMPREPLY=($(__PY__ __SCRIPT__ _complete new "$cur" --plain 2>/dev/null))
  fi
}
complete -F _csm csm
'''


def cmd_completion(shell):
    tpl = {'zsh': _ZSH_COMPLETION, 'bash': _BASH_COMPLETION}.get(shell or '')
    if not tpl:
        print("Usage: csm completion zsh|bash", file=sys.stderr)
        sys.exit(1)
    print(tpl.replace('__PY__', shlex.quote(sys.executable))
             .replace('__SCRIPT__', shlex.quote(os.path.realpath(__file__)))
             .replace('__CMDS__', ' '.join(_SUBCOMMANDS)), end='')


# ── Config command ──────────────────────────────────────────────────

def cmd_config(init=False):
    path = _config_path()
    if init:
        if path.exists():
            print(f"Config already exists at {path}", file=sys.stderr)
            sys.exit(1)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(DEFAULT_CONFIG, indent=2) + "\n")
        print(f"Wrote default config to {path}")
        print("Edit it to customize naming convention and clipboard copy.")
        return
    cfg = _load_config()
    copy_cmd = _copy_command()
    print(f"Config file: {path}{'' if path.exists() else '  (not present — using defaults)'}")
    print(f"Copy command: {copy_cmd or '(disabled)'}")
    print()
    print(json.dumps(cfg, indent=2))


# ── Main ─────────────────────────────────────────────────────────────

def main():
    args = sys.argv[1:]
    if not args:
        cmd_pick()
        return

    cmd = args[0]
    if cmd in ('-h', '--help', 'help'):
        print(__doc__.strip())
    elif cmd == 'note':
        task = args[1] if len(args) > 1 else None
        text = args[2] if len(args) > 2 else None
        cmd_note(task, text)
    elif cmd == 'hook':
        cmd_hook()
    elif cmd == 'new':
        if len(args) < 2:
            cmd_new_pick()
        else:
            cmd_new(' '.join(args[1:]))
    elif cmd in ('del', 'delete', 'rm'):
        if len(args) < 2:
            print("Usage: csm del <title-or-session-id>", file=sys.stderr)
            sys.exit(1)
        cmd_del(' '.join(args[1:]))
    elif cmd == 'hop':
        dry, handoff, message, rest = False, None, None, []
        it = iter(args[1:])
        for a in it:
            if a == '--dry-run':
                dry = True
            elif a == '--handoff':
                handoff = next(it, None)
                if not handoff:
                    print("Usage: csm hop [TITLE|ID] --handoff FILE", file=sys.stderr)
                    sys.exit(1)
            elif a == '--message':
                message = (next(it, None) or '').strip() or None
            else:
                rest.append(a)
        cmd_hop(' '.join(rest) if rest else None, dry_run=dry, handoff=handoff, message=message)
    elif cmd == 'tasks':
        conn, rest = None, []
        it = iter(args[1:])
        for a in it:
            if a == '--from':
                conn = next(it, None)
            else:
                rest.append(a)
        cmd_tasks(' '.join(rest) or None, conn)
    elif cmd == 'connections':
        cmd_connections()
    elif cmd == 'completion':
        cmd_completion(args[1] if len(args) > 1 else None)
    elif cmd == '_complete':
        cmd_complete(args[1:])
    elif cmd == '_refresh-cache':
        cmd_refresh_cache()
    elif cmd == 'status':
        if len(args) < 2:
            print("Usage: cc-sessions status <task> [open|wip|done|blocked]", file=sys.stderr)
            sys.exit(1)
        new_st = args[-1] if len(args) > 2 and args[-1] in STATUSES else None
        task_q = ' '.join(args[1:] if not new_st else args[1:-1])
        cmd_status(task_q, new_st)
    elif cmd == 'config':
        cmd_config('--init' in args)
    elif cmd == 'index':
        if INDEX_FILE.exists():
            print(INDEX_FILE.read_text())
        else:
            print("No index yet. Populated by SessionStart/End hooks.")
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
