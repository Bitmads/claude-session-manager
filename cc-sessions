def _next_session_number(sessions, ticket, phase=1):
    """Next free session number for ticket/phase among existing session titles."""
    best = 0
    for s in sessions:
        g = _parse_title(s.get('title') or '') or {}
        if (g.get('ticket') or '').upper() == ticket.upper() and str(g.get('phase')) == str(phase):
            try:
                best = max(best, int(g.get('session') or 0))
            except ValueError:
                pass
    return best + 1


def _task_matches(query, t):
    return _fuzzy_match(query, f"{t['key']} {t['title']}")


def _sorted_tasks(tasks):
    return sorted(tasks, key=lambda t: t.get('updated') or '', reverse=True)


def _task_worker(ts, conn, scope, stop_evt):
    """Background fetches for the task picker: recent() once, then search()
    for the latest query after the user pauses typing (debounce)."""
    want_recent = True
    done_query = None
    while not stop_evt.wait(0.1):
        with ts['lock']:
            q, q_at = ts['query'], ts['query_at']
        try:
            if want_recent:
                want_recent = False
                ts['status'] = 'loading…'
                found = list_tasks(conn, scope, None, 50)
            elif q and q != done_query and time.time() - q_at > 0.4:
                done_query = q
                ts['status'] = f'searching "{q}"…'
                found = list_tasks(conn, scope, q, 30)
            else:
                continue
            with ts['lock']:
                for t in found:
                    ts['tasks'][t['key']] = t
                if q and done_query == q:
                    # the tracker may match on fields we don't filter on locally
                    ts['hits'][q] = {t['key'] for t in found}
            ts['status'] = ''
        except TaskSourceError as e:
            ts['status'] = str(e)
        except Exception as e:
            ts['status'] = f'error: {e}'


def _wrap(text, width):
    import textwrap
    out = []
    for para in (text or '').splitlines():
        out.extend(textwrap.wrap(para, width) or [''])
    return out


def _draw_task_detail(win, top, left, h, w, t, sessions):
    cyan = curses.color_pair(_CP_CYAN) | curses.A_BOLD
    dim = curses.A_DIM
    lines = [(f"{t['key']}", cyan)]
    lines += [(l, curses.A_BOLD) for l in _wrap(t['title'], w)]
    meta = '  '.join(x for x in (t['status'], t['assignee'], (t['updated'] or '')[:10]) if x)
    if meta:
        lines.append((meta, dim))
    if t['url']:
        lines.append((t['url'][:w], dim))
    n = _next_session_number(sessions, t['key'])
    if n > 1:
        lines.append((f"{n - 1} existing session(s); Enter starts .{n:03d}", curses.color_pair(_CP_YELLOW)))
    lines.append(('', 0))
    lines += [(l, 0) for l in _wrap(t['description'], w)]
    for i, (text, attr) in enumerate(lines[:h]):
        try:
            win.addstr(top + i, left, text[:w], attr)
        except curses.error:
            pass


def _task_pick_loop(stdscr, conn, scope, sessions):
    """Search/pick a task. Returns a full session title, or None on Esc."""
    curses.curs_set(0)
    stdscr.timeout(150)
    ts = {'lock': threading.Lock(), 'query': '', 'query_at': 0.0, 'status': '', 'hits': {},
          'tasks': {t['key']: t for t in _cache_get(conn)
                    if not scope or t.get('project', '').upper() == scope.upper()}}
    stop_evt = threading.Event()
    threading.Thread(target=_task_worker, args=(ts, conn, scope, stop_evt), daemon=True).start()
    query, cursor, scroll = '', 0, 0
    try:
        while True:
            max_y, max_x = _sync_size(stdscr)
            with ts['lock']:
                tasks = _sorted_tasks(ts['tasks'].values())
                hits = ts['hits'].get(query, set())
            if query:
                tasks = [t for t in tasks if t['key'] in hits or _task_matches(query, t)]
            cursor = max(0, min(cursor, len(tasks) - 1))
            side = max_x >= 100
            list_w = max_x * 55 // 100 if side else max_x - 1
            list_h = max_y - 4 if side else max(3, (max_y - 4) // 2)
            if cursor < scroll:
                scroll = cursor
            elif cursor >= scroll + list_h:
                scroll = cursor - list_h + 1

            stdscr.erase()
            head = f" New session from {conn}{' / ' + scope if scope else ''}"
            keys = "Enter: start  Tab: edit title  Esc: back "
            try:
                stdscr.addstr(0, 0, ' ' * (max_x - 1), curses.color_pair(_CP_BAR))
                stdscr.addstr(0, 0, head[:max_x - 1], curses.color_pair(_CP_BAR) | curses.A_BOLD)
                if len(head) + len(keys) < max_x - 1:
                    stdscr.addstr(0, max_x - len(keys) - 1, keys, curses.color_pair(_CP_BAR))
            except curses.error:
                pass
            for i in range(list_h):
                ri = scroll + i
                if ri >= len(tasks):
                    break
                t = tasks[ri]
                attr = curses.color_pair(_CP_SEL) | curses.A_BOLD if ri == cursor else 0
                st = f"{t['status'][:12]:<12} " if t['status'] else ''
                line = f" {t['key']:<10} {st}{t['title']}"
                try:
                    stdscr.addstr(1 + i, 0, line[:list_w].ljust(list_w), attr)
                except curses.error:
                    pass
            if tasks:
                if side:
                    _draw_task_detail(stdscr, 1, list_w + 2, max_y - 4, max_x - list_w - 3, tasks[cursor], sessions)
                else:
                    _draw_task_detail(stdscr, 1 + list_h + 1, 1, max_y - list_h - 6, max_x - 2, tasks[cursor], sessions)
            elif not ts['status']:
                try:
                    stdscr.addstr(2, 2, "No tasks." if not query else "No match yet; searching the tracker…", curses.A_DIM)
                except curses.error:
                    pass
            info = f" {len(tasks)} tasks {('· ' + ts['status']) if ts['status'] else ''} "
            try:
                stdscr.addstr(max_y - 3, 0, '─' * (max_x - 1), curses.color_pair(_CP_CYAN))
                stdscr.addstr(max_y - 3, 2, info[:max_x - 4], curses.color_pair(_CP_BAR_ACC) | curses.A_REVERSE)
                stdscr.addstr(max_y - 2, 0, '❯ ', curses.color_pair(_CP_CYAN) | curses.A_BOLD)
                stdscr.addstr(max_y - 2, 2, query[:max_x - 3])
                stdscr.addstr(max_y - 1, 0, '─' * (max_x - 1), curses.color_pair(_CP_CYAN))
            except curses.error:
                pass
            stdscr.refresh()

            ch = stdscr.getch()
            if ch == -1 or ch == curses.KEY_RESIZE:
                continue
            if ch in (27, 3):
                return None
            if ch in (curses.KEY_UP, 16):
                cursor = max(0, cursor - 1)
            elif ch in (curses.KEY_DOWN, 14):
                cursor += 1
            elif ch in (curses.KEY_ENTER, 10, 13, 9) and tasks:
                t = tasks[cursor]
                title = _new_session_title(t['key'], 1, _next_session_number(sessions, t['key']),
                                           t['title'].strip())
                if ch == 9:  # Tab = edit before starting
                    title = _text_input(stdscr, max_y, max_x, ' Title: ', title)
                    if not title:
                        continue
                return title
            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                query = query[:-1]
                cursor = scroll = 0
            elif 32 <= ch <= 126:
                query += chr(ch)
                cursor = scroll = 0
            else:
                continue
            with ts['lock']:
                ts['query'], ts['query_at'] = query, time.time()
    finally:
        stop_evt.set()
        stdscr.timeout(250)


